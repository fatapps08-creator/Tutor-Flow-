# Public application origin. Register this callback URI in Google Cloud:
# {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Google OAuth credentials. Configure these in Google Cloud OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only encryption key for OAuth transaction and session cookies.
# Generate a strong random value, for example: openssl rand -base64 32
AUTH_SECRET=

# Development only. Never enable this in production.
TUTOR_FLOW_DEV_AUTH_BYPASS=false

# Optional local Google user allowlist. Only active in NODE_ENV=development.
# Configure the Google sub from a trusted source; email is profile information only.
TUTOR_FLOW_DEV_USER_GOOGLE_SUB=
TUTOR_FLOW_DEV_USER_ID=dev:local-google-user
TUTOR_FLOW_DEV_USER_EMAIL=
TUTOR_FLOW_DEV_USER_NAME=Local Google User
TUTOR_FLOW_DEV_USER_STATUS=ACTIVE

# Server-only JSON array of { center, membership } provisioning records.
TUTOR_FLOW_PROVISIONED_TENANTS_JSON=

# Server-only Google Apps Script persistence configuration.
GOOGLE_APPS_SCRIPT_URL=
TUTOR_FLOW_APPS_SCRIPT_HMAC_SECRET=
TUTOR_FLOW_API_KEY=
# Server-resolved single-center scope used until the B3 authorization resolver exists.
TUTOR_FLOW_APPS_SCRIPT_CENTER_ID=
