GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Explicit server-side development identity. Never accept tutor IDs from the browser.
TUTOR_FLOW_DEV_TUTOR_ID=tutor-demo
TUTOR_FLOW_DEV_TUTOR_EMAIL=
TUTOR_FLOW_DEV_TUTOR_NAME=
# Set to demo only for isolated demo storage; persistent mode is the default.
TUTOR_FLOW_DATA_MODE=persistent
