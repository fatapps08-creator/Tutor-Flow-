# Public application origin used to validate authentication requests.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable key. The key is safe for browser use;
# never configure a Supabase secret/service-role key in the application.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Development only. Never enable this in production.
TUTOR_FLOW_DEV_AUTH_BYPASS=false

# Optional local Supabase identity mapping. Only active in NODE_ENV=development.
# googleSubject stores the trusted Supabase Auth user UUID in the existing directory shape.
TUTOR_FLOW_DEV_USER_SUPABASE_ID=
TUTOR_FLOW_DEV_USER_ID=dev:local-supabase-user
TUTOR_FLOW_DEV_USER_EMAIL=
TUTOR_FLOW_DEV_USER_NAME=Local Supabase User
TUTOR_FLOW_DEV_USER_STATUS=ACTIVE

# Server-only provisioned users. googleSubject must equal the verified Supabase Auth user UUID.
TUTOR_FLOW_PROVISIONED_USERS_JSON=[]

# Server-only JSON array of { center, membership } provisioning records.
TUTOR_FLOW_PROVISIONED_TENANTS_JSON=

# Server-only Google Apps Script persistence configuration.
GOOGLE_APPS_SCRIPT_URL=
# Optional Phase 2 hardening. Keep disabled unless Apps Script verifies HMAC assertions.
TUTOR_FLOW_APPS_SCRIPT_HMAC_ENABLED=false
TUTOR_FLOW_APPS_SCRIPT_HMAC_SECRET=
TUTOR_FLOW_API_KEY=
# Server-resolved single-center scope used until the B3 authorization resolver exists.
TUTOR_FLOW_APPS_SCRIPT_CENTER_ID=
